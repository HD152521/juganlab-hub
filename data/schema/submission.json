{
  "version": 1,
  "note": "작품 올리기 폼의 입력 정의. 폼은 이 파일을 읽어 만들고, 서버(Supabase)는 같은 한도를 DB 제약으로 다시 검사한다. 질문을 늘리고 줄일 때는 코드가 아니라 이 파일을 고친다. kind: text | longtext | url | select | multiselect | boolean | tags",
  "limits": {
    "name": 60,
    "summary": 200,
    "description": 4000,
    "tags": 8,
    "tagLength": 20,
    "links": 8,
    "howtoSteps": 10,
    "howtoText": 300,
    "screenshots": 8,
    "imageBytes": 1048576,
    "imageMaxPixels": 4096,
    "imageFormats": ["webp"],
    "detailsBytes": 4096
  },
  "common": [
