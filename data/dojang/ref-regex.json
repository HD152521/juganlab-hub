{
  "slug": "regex",
  "title": "정규식 도감",
  "description": "자주 쓰는 정규식 조각과 실전 패턴을 설명과 함께 모았습니다. 눌러서 바로 복사하세요.",
  "intro": "정규식은 '문자 하나의 종류(클래스) + 몇 번(수량자) + 어디에(위치)'를 조합해서 읽습니다. 아래 조각을 먼저 익히고 실전 패턴을 보세요.",
  "sections": [
    { "name": "문자 종류", "items": [
      { "term": "\\d", "short": "숫자 한 글자(0–9)", "example": "\\d\\d\\d", "detail": "반대는 \\D(숫자가 아닌 것)입니다." },
      { "term": "\\w", "short": "영문자·숫자·밑줄 한 글자", "example": "\\w+", "detail": "한글은 \\w 에 포함되지 않습니다. 한글은 [가-힣] 으로 씁니다." },
      { "term": "\\s", "short": "공백·탭·줄바꿈 같은 빈칸 한 글자", "example": "\\s+" },
      { "term": ".", "short": "줄바꿈을 뺀 아무 글자 하나", "example": "a.c", "detail": "점 자체를 찾으려면 \\. 로 씁니다." },
      { "term": "[abc]", "short": "a, b, c 중 하나", "example": "[aeiou]", "detail": "범위는 [a-z], 제외는 [^abc] 입니다." }
    ]},
    { "name": "횟수와 위치", "items": [
      { "term": "*  +  ?", "short": "0번 이상 / 1번 이상 / 0 또는 1번", "example": "colou?r", "detail": "colou?r 은 color 와 colour 둘 다 맞습니다." },
      { "term": "{n,m}", "short": "n번 이상 m번 이하", "example": "\\d{3,4}", "detail": "{3} 은 정확히 3번, {3,} 은 3번 이상입니다." },
      { "term": "^  $", "short": "문자열(또는 줄)의 시작 / 끝", "example": "^\\d+$", "detail": "전체가 숫자로만 이뤄졌는지 검사할 때 양쪽에 붙입니다." },
      { "term": "\\b", "short": "단어 경계", "example": "\\bcat\\b", "detail": "cat 은 맞고 category 는 맞지 않습니다." },
      { "term": "*?  +?", "short": "가능한 한 짧게 맞추는(게으른) 수량자", "example": "<.+?>", "detail": "<.+> 는 첫 < 부터 마지막 > 까지 길게 잡지만 <.+?> 는 태그 하나씩 잡습니다." }
    ]},
    { "name": "묶기와 선택", "items": [
      { "term": "(abc)", "short": "묶어서 한 덩어리로 보고 값을 따로 꺼낼 수 있게 합니다(캡처).", "example": "(\\d{4})-(\\d{2})-(\\d{2})", "detail": "첫 괄호는 $1, 둘째는 $2 로 꺼냅니다." },
      { "term": "(?:abc)", "short": "묶기만 하고 값은 따로 저장하지 않습니다.", "example": "(?:https?|ftp)://" },
      { "term": "a|b", "short": "a 또는 b", "example": "(?:png|jpe?g|gif)$" },
      { "term": "(?=…)  (?!…)", "short": "뒤에 …이 오는(긍정) / 오지 않는(부정) 자리를 찾는 전방탐색", "example": "\\d+(?=원)", "detail": "'원' 앞의 숫자만 찾고 '원' 자체는 결과에 넣지 않습니다." }
    ]},
    { "name": "실전 패턴", "items": [
      { "term": "휴대폰 번호(010)", "short": "010-1234-5678 형태", "example": "^010-\\d{4}-\\d{4}$", "detail": "하이픈 유무를 모두 받으려면 ^010-?\\d{4}-?\\d{4}$ 로 씁니다." },
      { "term": "이메일(간단 검사)", "short": "@ 앞뒤에 글자가 있는지 정도만 봅니다.", "example": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$", "detail": "완벽한 이메일 검증은 정규식으로 불가능에 가깝습니다. 가입 확인 메일을 보내 검증하세요." },
      { "term": "날짜 YYYY-MM-DD", "short": "형태만 검사합니다.", "example": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "detail": "2월 30일 같은 실제 존재 여부는 정규식이 아니라 날짜 라이브러리로 확인합니다." },
      { "term": "한글만", "short": "완성형 한글 글자로만 이뤄졌는지", "example": "^[가-힣]+$", "detail": "자음·모음만 있는 글자(ㄱ, ㅏ)까지 허용하려면 [ㄱ-ㅎㅏ-ㅣ가-힣] 로 넓힙니다." },
      { "term": "비밀번호 규칙(영문+숫자 8자 이상)", "short": "전방탐색으로 '반드시 포함'을 확인합니다.", "example": "^(?=.*[A-Za-z])(?=.*\\d).{8,}$" },
      { "term": "URL 에서 도메인 뽑기", "short": "캡처 그룹으로 호스트만 꺼냅니다.", "example": "^https?://([^/:?#]+)", "detail": "실제 서비스에서는 정규식보다 URL 파서(new URL)가 안전합니다." },
      { "term": "앞뒤 공백 지우기", "short": "치환에 씁니다.", "example": "^\\s+|\\s+$", "detail": "빈 문자열로 치환합니다. JS 에서는 trim() 이 더 간단합니다." }
    ]}
  ]
}
